# ---------------------------------------------------------------------------
# AptMappr environment variables
#
# The app runs with NO configuration at all: leave everything blank and your
# data is stored locally in the browser (great for trying it out).
#
# To turn it into a real cloud, multi-user app, create a free Supabase project
# and fill in the two NEXT_PUBLIC_SUPABASE_* values below. That's it.
# ---------------------------------------------------------------------------

# --- Supabase (optional, enables cloud sync + login) -----------------------
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public "anon" key (safe to expose in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Map tiles (optional) --------------------------------------------------
# Any {z}/{x}/{y} raster tile template. Defaults to CARTO Voyager if unset.
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# --- Geocoding + routing services (optional overrides) ---------------------
# Defaults use the public OpenStreetMap Nominatim + OSRM demo servers, which
# are fine for personal use but rate-limited and NOT allowed for heavy/paid
# production traffic. For production, point these at your own instances
# (or swap in a commercial provider) via the server-side variables below.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
